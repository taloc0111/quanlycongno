# ============================================================
# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file `.env` (đã được .gitignore bỏ qua).
# ============================================================

# --- Cách 1: dùng 1 chuỗi kết nối (khuyên dùng khi deploy Neon/Render) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Cách 2: các biến rời (chạy local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debt_management
DB_USER=postgres
DB_PASSWORD=

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT — sinh chuỗi ngẫu nhiên >= 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=24h

# Tự áp schema.sql khi khởi động (mặc định bật). Đặt false để tự quản lý migrate.
AUTO_MIGRATE=true

# URL frontend để dựng link đặt lại mật khẩu (vd https://app.example.com)
APP_URL=http://localhost:5173

# --- Gửi email (quên mật khẩu). Chưa cấu hình thì link reset sẽ ghi ra log. ---
# KHUYẾN NGHỊ trên Render/Vercel: dùng Resend HTTP API (Render free CHẶN cổng SMTP).
#   1) Đăng ký https://resend.com → verify domain (vd district2.studio) → tạo API key
#   2) Đặt 2 biến dưới; EMAIL_FROM phải thuộc domain đã verify.
RESEND_API_KEY=
EMAIL_FROM=no-reply@district2.studio

# (Tùy chọn) SMTP — chỉ dùng khi KHÔNG đặt RESEND_API_KEY và môi trường cho phép cổng SMTP.
# Gmail: bật 2FA rồi tạo "App password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# SerpApi (Google Flights) — nguồn giá CHÍNH cho Canh vé / Check vé khi có key.
# 1 search trả giá MỌI hãng trên chặng, không cần Chromium → chạy được ngay trên
# web service. Không có key (hoặc hết hạn mức) → tự rơi về adapter HTTP trực tiếp (VNA).
# ============================================================
# Lấy key: https://serpapi.com → Dashboard → API Key. Gói free: 250 search/tháng.
SERPAPI_KEY=
# Hạn mức search/tháng — đặt theo gói SerpApi đang dùng (free = 250). Đếm chung
# web + worker qua bảng api_usage; chạm hạn mức thì tự chuyển sang scrape.
SERPAPI_MONTHLY_LIMIT=250

# ============================================================
# Vòng canh giá tự động (nguồn SerpApi + API hãng — KHÔNG cần Chromium, chạy
# ngay trong tiến trình app hoặc bằng cron `npm run fare-watch`).
# Chỉ canh các watch ĐÃ BẬT "Tự động canh giá"; watch có Ngày về = canh TỔNG
# khứ hồi → tốn 2 lượt SerpApi/lần canh thay vì 1.
# ============================================================
# Bật vòng canh ngay trong tiến trình app (server.js). false/bỏ trống = tắt
# (vẫn dùng được nút "Lấy giá ngay" + "Check vé"; hoặc canh bằng cron ngoài).
FARE_WATCHER=false
# Bao nhiêu PHÚT chạy 1 vòng canh. Đặt to để khít hạn mức SerpApi:
#   ví dụ 4 chặng 1 chiều × 2 vòng/ngày (=720) ≈ 240 search/tháng — vừa gói free 250.
FARE_WATCH_INTERVAL_MIN=720
# Công tắc GỬI EMAIL cảnh báo đạt giá. false = không gửi mail (badge "đạt giá"
# trên app vẫn hiện bình thường) — dùng khi email đang lỗi/chưa cấu hình.
FARE_ALERT_EMAIL=true
# Giờ tối thiểu giữa 2 email cảnh báo cho cùng 1 watch (chống spam).
FARE_ALERT_COOLDOWN_H=12
