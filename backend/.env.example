# ============================================================
# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file `.env` (đã được .gitignore bỏ qua).
# ============================================================

# --- Cách 1: dùng 1 chuỗi kết nối (khuyên dùng khi deploy Neon/Render) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Cách 2: các biến rời (chạy local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debt_management
DB_USER=postgres
DB_PASSWORD=

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT — sinh chuỗi ngẫu nhiên >= 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=24h

# Tự áp schema.sql khi khởi động (mặc định bật). Đặt false để tự quản lý migrate.
AUTO_MIGRATE=true

# URL frontend để dựng link đặt lại mật khẩu (vd https://app.example.com)
APP_URL=http://localhost:5173

# --- Gửi email (quên mật khẩu). Chưa cấu hình thì link reset sẽ ghi ra log. ---
# KHUYẾN NGHỊ trên Render/Vercel: dùng Resend HTTP API (Render free CHẶN cổng SMTP).
#   1) Đăng ký https://resend.com → verify domain (vd district2.studio) → tạo API key
#   2) Đặt 2 biến dưới; EMAIL_FROM phải thuộc domain đã verify.
RESEND_API_KEY=
EMAIL_FROM=no-reply@district2.studio

# (Tùy chọn) SMTP — chỉ dùng khi KHÔNG đặt RESEND_API_KEY và môi trường cho phép cổng SMTP.
# Gmail: bật 2FA rồi tạo "App password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# SerpApi (Google Flights) — nguồn giá CHÍNH cho Canh vé / Check vé khi có key.
# 1 search trả giá MỌI hãng trên chặng, không cần Chromium → chạy được ngay trên
# web service. Không có key (hoặc hết hạn mức) → tự rơi về adapter scrape (Playwright).
# ============================================================
# Lấy key: https://serpapi.com → Dashboard → API Key. Gói free: 250 search/tháng.
SERPAPI_KEY=
# Hạn mức search/tháng — đặt theo gói SerpApi đang dùng (free = 250). Đếm chung
# web + worker qua bảng api_usage; chạm hạn mức thì tự chuyển sang scrape.
SERPAPI_MONTHLY_LIMIT=250

# ============================================================
# Worker canh giá / check vé (Playwright). Xem DEPLOY.md mục 5.
# ============================================================
# --- TRÊN API (Render): trỏ tới worker để uỷ thác việc chạy Chromium ---
# Bỏ trống = tắt (nút "Lấy giá ngay" + "Check vé" trả 503; vòng canh vẫn chạy ở worker).
# WORKER_URL phải dùng HTTPS (đặt sau reverse proxy TLS) — nếu không sẽ bị từ chối.
WORKER_URL=
# WORKER_SECRET: chuỗi ngẫu nhiên >= 32 ký tự, GIỐNG HỆT trên API và worker. Không để trống.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
WORKER_SECRET=
# Thời gian chờ worker phản hồi (ms) — lấy giá có thể mất vài chục giây.
WORKER_TIMEOUT_MS=90000

# --- TRÊN WORKER (VPS) chạy `npm run fare-watch:serve`: ---
# WORKER_PORT=6000                 # cổng HTTP nội bộ của worker
# WORKER_ALLOW_INSECURE=true       # CHỈ test local: cho phép chạy không secret / không HTTPS
# FARE_WATCH_INTERVAL_MIN=60       # phút giữa các vòng canh tự động
# FARE_ALERT_COOLDOWN_H=12         # giờ tối thiểu giữa 2 email cảnh báo cùng 1 watch
