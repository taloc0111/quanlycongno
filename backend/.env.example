# ============================================================
# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file `.env` (đã được .gitignore bỏ qua).
# ============================================================

# --- Cách 1: dùng 1 chuỗi kết nối (khuyên dùng khi deploy Neon/Render) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Cách 2: các biến rời (chạy local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debt_management
DB_USER=postgres
DB_PASSWORD=

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT — sinh chuỗi ngẫu nhiên >= 32 ký tự:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=24h
