# URL gốc của backend API. Để trống khi chạy local (mặc định http://localhost:5000/api).
# Khi deploy: đặt thành URL backend trên Render, ví dụ:
#   VITE_API_URL=https://your-app.onrender.com/api
VITE_API_URL=

# Nút liên hệ Zalo (góc dưới-phải + link trong banner dùng thử).
# Đặt VITE_ZALO_ENABLED=false để TẮT nút. Để trống/true = bật.
VITE_ZALO_ENABLED=true
# (Tùy chọn) override link & số Zalo mà không cần sửa code:
VITE_ZALO_URL=
VITE_ZALO_NUMBER=
